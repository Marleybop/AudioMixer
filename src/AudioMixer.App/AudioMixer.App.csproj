<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AudioMixer</AssemblyName>
    <Product>AudioMixer</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by tools/make_icon.py -->
    <ApplicationIcon>Assets\AudioMixer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AudioMixer.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioMixer.Core\AudioMixer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

</Project>
