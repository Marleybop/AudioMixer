<Window x:Class="AudioMixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioMixer.App.ViewModels"
        Title="AudioMixer" Icon="/Assets/AudioMixer.ico" Width="980" Height="720" MinWidth="820" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <DockPanel>
        <!-- Status header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AudioMixer" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding HeadsetSummary}" Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="OUTPUT" Style="{StaticResource Hint}" FontSize="10"/>
                        <TextBlock Text="{Binding OutputName}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="MIC" Style="{StaticResource Hint}" FontSize="10"/>
                        <TextBlock FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Text" Value="{Binding InputName}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                            <Setter Property="Text" Value="Muted on headset"/>
                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="NOISE" Style="{StaticResource Hint}" FontSize="10"/>
                        <TextBlock Text="{Binding NoiseControlText}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GG takeover banner -->
        <Border DockPanel.Dock="Top" Background="#33FF6A13" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1" Padding="20,12"
                Visibility="{Binding GgIsRunning, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Take over from SteelSeries GG" Command="{Binding TakeOverCommand}"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                           Text="SteelSeries GG / Sonar is running. AudioMixer is watching only, so the two don't fight over your audio. Take over to let AudioMixer manage routing, ChatMix and your mic (GG is stopped and won't start with Windows; you can undo this in Settings)."/>
            </DockPanel>
        </Border>

        <!-- Problems -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Problems}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Problems}" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Margin="12,4,12,0">
            <!-- ===== Mixer ===== -->
            <TabItem Header="Mixer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Channels" Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Each channel is a sound device apps can play to. Point a game's voice chat at 'Chat' and its sound at 'Game', and ChatMix works inside the game."/>
                                <ItemsControl ItemsSource="{Binding Channels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChannelStripViewModel}">
                                            <Border Background="{StaticResource PanelHi}" CornerRadius="8" Margin="4" Padding="12">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <Slider Orientation="Vertical" Height="180" Minimum="0" Maximum="100" Margin="0,12"
                                                            Value="{Binding Volume}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" HorizontalAlignment="Center" Style="{StaticResource Hint}"/>
                                                    <CheckBox Content="Mute" IsChecked="{Binding Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding SonarStatus}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ChatMix" Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Follows the dial on your base station. Turn toward chat to fade everything else; toward the other side to fade chat."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Game / Media" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding ChatMix}" IsEnabled="{Binding ChatMixEnabled}"/>
                                    <TextBlock Grid.Column="2" Text="Chat" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox Content="ChatMix enabled" IsChecked="{Binding ChatMixEnabled}" Margin="0,4,24,4"/>
                                    <TextBlock Text="Fades with the dial:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <CheckBox Content="Game" IsChecked="{Binding ChatMixFadesGame}" Margin="0,4,16,4"/>
                                    <CheckBox Content="Media" IsChecked="{Binding ChatMixFadesMedia}" Margin="0,4,16,4"/>
                                    <CheckBox Content="Aux" IsChecked="{Binding ChatMixFadesAux}" Margin="0,4,16,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Devices ===== -->
            <TabItem Header="Devices">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Output priority" Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="All channels play through the first ticked device that's available. Your wireless headset only counts as available while it's switched on. Blocked devices are kept disabled so nothing can grab them."/>
                                <ItemsControl ItemsSource="{Binding OutputDevices}" ItemTemplate="{DynamicResource DeviceRow}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Microphone priority" Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="The first available ticked mic feeds the virtual microphone that Discord and games use."/>
                                <ItemsControl ItemsSource="{Binding InputDevices}" ItemTemplate="{DynamicResource DeviceRow}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Headset ===== -->
            <TabItem Header="Headset">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12">
                    <StackPanel IsEnabled="{Binding BaseStationConnected}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Flat" Command="{Binding ResetEqCommand}"/>
                                    <TextBlock Text="Headset EQ" Style="{StaticResource Heading}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="Runs on the base station's own DSP: no CPU use, and it applies to everything you hear on the headset, including Bluetooth. ±10 dB in 0.5 dB steps."/>
                                <ItemsControl ItemsSource="{Binding EqBands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                            <StackPanel HorizontalAlignment="Center" Margin="2">
                                                <TextBlock Text="{Binding Gain, StringFormat={}{0:+0.0;-0.0;0}}" HorizontalAlignment="Center" Style="{StaticResource Hint}"/>
                                                <Slider Orientation="Vertical" Height="160" Minimum="-10" Maximum="10" SmallChange="0.5" LargeChange="1"
                                                        TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding Gain}" Margin="0,8"
                                                        HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Sidetone" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="3" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Sidetone}" Margin="0,8"/>
                                <TextBlock Grid.Column="2" Text="{Binding Sidetone}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Mic volume" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding MicVolume}" Margin="0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MicVolume}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="Low battery alert" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding LowBatteryWarning}" Margin="0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LowBatteryWarning, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource Heading}"/>
                                <CheckBox Content="Start with Windows (in the tray)" IsChecked="{Binding StartWithWindows}"/>
                                <CheckBox Content="Keep Windows' default devices on the AudioMixer channels" IsChecked="{Binding ManageWindowsDefaults}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,0"
                                           Text="Default playback = Game, communications = Chat, recording = the virtual mic. Re-applied if something (like a newly plugged controller) takes over."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SteelSeries GG" Style="{StaticResource Heading}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                           Text="AudioMixer uses the Sonar virtual audio driver that GG installed, and replaces the GG and Sonar apps. Keep GG installed so the driver stays; it just doesn't need to run."/>
                                <Button Content="Let GG start with Windows again" Command="{Binding RestoreGGCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>

    <Window.Resources>
        <DataTemplate x:Key="DeviceRow" DataType="{x:Type vm:DeviceItemViewModel}">
            <Border Background="{StaticResource PanelHi}" CornerRadius="6" Padding="10,6" Margin="0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding Blocked, Converter={StaticResource Invert}}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="4" Content="Block" IsChecked="{Binding Blocked}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
</Window>
