<Window x:Class="AudioMixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioMixer.App.ViewModels"
        xmlns:c="clr-namespace:AudioMixer.App.Controls"
        Title="AudioMixer" Icon="/Assets/AudioMixer.ico" Width="1280" Height="800" MinWidth="1040" MinHeight="660"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ===== Shell: title bar with the section tabs, banners, and the selected page ===== -->
        <ControlTemplate x:Key="Shell" TargetType="TabControl">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="56" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                            <Path Data="M4,18 V9 M9,18 V4 M14,18 V11 M19,18 V7" Stroke="{StaticResource Accent}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22"/>
                            <TextBlock Text="AUDIOMIXER" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding HeaderStatus}" Style="{StaticResource Mono}" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
                        <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Faint}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeadsetOn}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Good}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="3"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- GG still running: we only watch -->
                <Border DockPanel.Dock="Top" Background="#33E8A33D" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1" Padding="20,10"
                        Visibility="{Binding GgIsRunning, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Take over from SteelSeries GG" Command="{Binding TakeOverCommand}"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                                   Text="SteelSeries GG is running, so AudioMixer is only watching. Take over to let AudioMixer run routing, ChatMix and your mic. GG is stopped and won't start with Windows; you can undo this in Settings."/>
                    </DockPanel>
                </Border>

                <!-- Problems -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Problems}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Problems}" Foreground="{StaticResource Bad}" TextWrapping="Wrap"/>
                </Border>

                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="18,16"/>
            </DockPanel>
        </ControlTemplate>

        <!-- ===== One channel strip ===== -->
        <DataTemplate x:Key="Strip" DataType="{x:Type vm:ChannelStripViewModel}">
            <Border Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="5,0" Padding="10">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="3" Background="{Binding Color}" CornerRadius="2" Margin="-10,-10,-10,10"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name, Converter={StaticResource Upper}}" FontWeight="Bold" FontSize="17"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Apps}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Apps}" Margin="0,2,0,10"/>

                    <!-- Where it goes (or, for the mic, where it comes from) -->
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                <Setter Property="Text" Value="PLAYS ON"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMic}" Value="True">
                                        <Setter Property="Text" Value="MIC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding DeviceChoices}" SelectedItem="{Binding SelectedDevice}"
                              IsEnabled="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="{Binding DeviceName}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} device}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceChoice}">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- EQ: opens this channel's EQ & effects page -->
                    <Button DockPanel.Dock="Top" Style="{StaticResource ChipButton}" Margin="0,6,0,0"
                            Command="{Binding DataContext.OpenSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            ToolTip="Open this channel's EQ and effects" AutomationProperties.Name="{Binding Name, StringFormat={}{0} EQ and effects}"
                            Visibility="{Binding Sound, Converter={StaticResource NullToCollapsed}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
                            <TextBlock Text="EQ" Foreground="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Sound.PresetLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>

                    <!-- Mute -->
                    <ToggleButton DockPanel.Dock="Bottom" Margin="0,10,0,0" Style="{StaticResource MuteBox}" Content="MUTE" IsChecked="{Binding Muted}"
                                  AutomationProperties.Name="{Binding Name, StringFormat=Mute {0}}"/>

                    <!-- Volume value -->
                    <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,14,0,8" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="{Binding Volume, StringFormat={}{0:0}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                        <Setter Property="Text" Value="MUTED"/>
                                        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Volume bar + live meter -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                        </Grid.ColumnDefinitions>
                        <c:LevelBar Value="{Binding Volume}" Cap="{StaticResource Text}" SmallChange="2" MaxWidth="76" Margin="0,0,8,0"
                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0} volume}">
                            <c:LevelBar.Style>
                                <Style TargetType="c:LevelBar" BasedOn="{StaticResource {x:Type c:LevelBar}}">
                                    <Setter Property="Fill" Value="{Binding Color}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Muted}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource LineHi}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:LevelBar.Style>
                        </c:LevelBar>
                        <c:LevelBar Grid.Column="1" Value="{Binding Peak, Mode=OneWay}" IsReadOnly="True" Focusable="False" Segments="30"
                                    Fill="{StaticResource Good}" HotFill="{StaticResource Bad}" HotFraction="0.9" Track="{StaticResource SegOff}"
                                    Cursor="Arrow" AutomationProperties.Name="{Binding Name, StringFormat={}{0} level}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ===== One device in a priority list ===== -->
        <DataTemplate x:Key="DeviceRow" DataType="{x:Type vm:DeviceItemViewModel}">
            <Border x:Name="row" Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RankText}" Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" IsEnabled="{Binding Blocked, Converter={StaticResource Invert}}" VerticalAlignment="Center"
                              ToolTip="Use this device when it's available" AutomationProperties.Name="{Binding Name, StringFormat=Use {0}}" Margin="0"/>
                    <StackPanel Grid.Column="2" Margin="6,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="name" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock x:Name="state" Text="{Binding StateText}" Style="{StaticResource Label}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up" AutomationProperties.Name="Move up"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down" AutomationProperties.Name="Move down" Margin="4,0"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        <ToggleButton Style="{StaticResource MuteBox}" Content="BLOCK" Width="64" MinHeight="34" FontSize="12" IsChecked="{Binding Blocked}"
                                      ToolTip="Keep this device disabled so nothing can use it" AutomationProperties.Name="{Binding Name, StringFormat=Block {0}}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="#FF2F5A37"/>
                    <Setter TargetName="row" Property="Background" Value="#FF22261F"/>
                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource Good}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Blocked}" Value="True">
                    <Setter TargetName="state" Property="Foreground" Value="{StaticResource Bad}"/>
                    <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Null}">
                    <Setter TargetName="row" Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <TabControl Template="{StaticResource Shell}" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTab}">

        <!-- ================= MIXER ================= -->
        <TabItem Header="MIXER">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Headset quick panel -->
                <Border Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                        <StackPanel IsEnabled="{Binding BaseStationConnected}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                            <Setter Property="Foreground" Value="{StaticResource Subtle}"/>
                                            <Setter Property="Text" Value="OFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeadsetOn}" Value="True">
                                                    <Setter Property="Text" Value="2.4 GHz"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="NOVA PRO WIRELESS" FontWeight="Bold" FontSize="14"/>
                            </DockPanel>

                            <!-- Headset drawing + batteries -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="100" Height="94" VerticalAlignment="Center">
                                    <Canvas Width="120" Height="112">
                                        <Path Data="M22,62 V50 A38,38 0 0 1 98,50 V62" Stroke="#FFC9C6BF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M30,22 A38,38 0 0 1 90,22" Stroke="#FF5A5D64" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Rectangle Canvas.Left="12" Canvas.Top="56" Width="24" Height="40" RadiusX="10" RadiusY="10" Fill="{StaticResource PanelHi}" Stroke="#FFC9C6BF" StrokeThickness="2.5"/>
                                        <Rectangle Canvas.Left="84" Canvas.Top="56" Width="24" Height="40" RadiusX="10" RadiusY="10" Fill="{StaticResource PanelHi}" Stroke="#FFC9C6BF" StrokeThickness="2.5"/>
                                        <Path x:Name="boom" Data="M16,90 C12,100 22,108 38,108 H48" StrokeThickness="2.5" StrokeEndLineCap="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{StaticResource Good}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMicSilenced}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Ellipse Canvas.Left="47" Canvas.Top="104" Width="8" Height="8" Fill="{Binding Stroke, ElementName=boom}"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HeadsetBattery, StringFormat={}{0}%}" Style="{StaticResource Mono}"/>
                                        <TextBlock Text="HEADSET" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <c:LevelBar Value="{Binding HeadsetBattery, Mode=OneWay}" IsReadOnly="True" Focusable="False" Cursor="Arrow" Orientation="Horizontal"
                                                Segments="8" Height="12" Margin="0,4,0,12" Fill="{StaticResource Good}" Track="{StaticResource SegOff}"
                                                AutomationProperties.Name="Headset battery"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SpareBattery, StringFormat={}{0}%}" Style="{StaticResource Mono}"/>
                                        <TextBlock Text="SPARE" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <c:LevelBar Value="{Binding SpareBattery, Mode=OneWay}" IsReadOnly="True" Focusable="False" Cursor="Arrow" Orientation="Horizontal"
                                                Segments="8" Height="12" Margin="0,4,0,0" Fill="{StaticResource Good}" Track="{StaticResource SegOff}"
                                                AutomationProperties.Name="Spare battery"/>
                                </StackPanel>
                            </Grid>

                            <!-- Quick tiles -->
                            <UniformGrid Columns="2" Margin="-4,14,-4,0">
                                <Button Style="{StaticResource TileButton}" Margin="4" Command="{Binding ToggleMicMuteCommand}" ToolTip="Mute or unmute the mic for every app">
                                    <StackPanel>
                                        <TextBlock Text="MIC" Style="{StaticResource Label}"/>
                                        <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding MicStatusText}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMicSilenced}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Border Margin="4" Padding="10,8" CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Well}">
                                    <StackPanel>
                                        <TextBlock Text="NOISE" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding NoiseControlText}" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="button on headset" FontSize="11" Foreground="{StaticResource Faint}"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="4" Padding="10,8" CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Well}">
                                    <StackPanel>
                                        <TextBlock Text="BLUETOOTH" Style="{StaticResource Label}"/>
                                        <TextBlock Text="{Binding BluetoothText}" FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="button on headset" FontSize="11" Foreground="{StaticResource Faint}"/>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource TileButton}" Margin="4" Command="{Binding ToggleRangeModeCommand}"
                                        ToolTip="Speed has lower latency; Range reaches further">
                                    <StackPanel>
                                        <TextBlock Text="WIRELESS" Style="{StaticResource Label}"/>
                                        <TextBlock FontSize="15" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Speed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RangeMode}" Value="True">
                                                            <Setter Property="Text" Value="Range"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <!-- Quick bars -->
                            <DockPanel Margin="0,14,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding HeadsetVolume, StringFormat={}{0} / 56}"/>
                                <TextBlock Text="HEADSET VOLUME (DIAL)" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Value="{Binding HeadsetVolume, Mode=OneWay}" Maximum="56" Segments="14"
                                        IsReadOnly="True" Focusable="False" Cursor="Arrow" Fill="#FFC9C6BF" AutomationProperties.Name="Headset volume"/>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding MicVolume, StringFormat={}{0} / 10}"/>
                                <TextBlock Text="MIC GAIN" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Value="{Binding MicVolume}" Maximum="10" Segments="10" AutomationProperties.Name="Mic gain"/>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding SidetoneText}"/>
                                <TextBlock Text="SIDETONE (HEAR YOURSELF)" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Value="{Binding Sidetone}" Maximum="3" Segments="3" AutomationProperties.Name="Sidetone"/>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding Brightness, StringFormat={}{0} / 10}"/>
                                <TextBlock Text="SCREEN BRIGHTNESS" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Value="{Binding Brightness}" Maximum="10" Segments="10" AutomationProperties.Name="Screen brightness"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Channel strips + ChatMix -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="7,12">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource Strip}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding SonarStatus}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SonarAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="CHATMIX" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                            <Setter Property="Text" Value="follows the base station dial"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChatMixEnabled}" Value="False">
                                                    <Setter Property="Text" Value="off: the dial doesn't change the mix"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center" Width="96"
                                       Text="{Binding ChatMixGamePercent, StringFormat=GAME {0}%}"/>
                            <c:LevelBar Grid.Column="2" Orientation="Horizontal" Height="28" Minimum="-100" Maximum="100" Origin="0" ResetValue="0"
                                        SmallChange="5" Value="{Binding ChatMix}" Cap="{StaticResource Text}" IsEnabled="{Binding ChatMixEnabled}"
                                        AutomationProperties.Name="ChatMix balance, game against chat"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Mono}" FontSize="13" VerticalAlignment="Center" Width="86" TextAlignment="Right"
                                       Text="{Binding ChatMixChatPercent, StringFormat=CHAT {0}%}"/>
                            <CheckBox Grid.Column="4" Style="{StaticResource Switch}" Content="On" IsChecked="{Binding ChatMixEnabled}" Margin="18,0,0,0" VerticalAlignment="Center"
                                      ToolTip="On: turning the dial on the base station (or dragging this bar) balances Game against Chat. Off: Game and Chat both stay at full volume and the dial does nothing to the mix."/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ================= EQ & EFFECTS ================= -->
        <TabItem Header="EQ &amp; EFFECTS">
            <Grid x:Name="soundPage" DataContext="{Binding SelectedSound}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Channel picker -->
                <ListBox Style="{StaticResource Options}" ItemsSource="{Binding DataContext.Sounds, RelativeSource={RelativeSource AncestorType=Window}}"
                         SelectedItem="{Binding DataContext.SelectedSound, RelativeSource={RelativeSource AncestorType=Window}}"
                         SelectedValuePath="" DisplayMemberPath="" AutomationProperties.Name="Channel">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelSoundViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="2,0">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="{Binding PresetLabel}" FontSize="12" Opacity="0.75" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="310"/>
                    </Grid.ColumnDefinitions>

                    <!-- Presets -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="PRESETS" Style="{StaticResource Heading}"/>
                            <TextBox DockPanel.Dock="Top" Text="{Binding PresetFilter, UpdateSourceTrigger=PropertyChanged}" Tag="Search presets"
                                     AutomationProperties.Name="Search presets"/>
                            <!-- Save as -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <TextBlock Text="SAVE CURRENT SOUND AS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SavePresetCommand}" Margin="6,0,0,0"/>
                                    <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Tag="Preset name" AutomationProperties.Name="New preset name">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SavePresetCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                            </StackPanel>
                            <ListBox x:Name="presetList" ItemsSource="{Binding Presets}" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" AutomationProperties.Name="Presets">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="4,10,0,4"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="b" Padding="8,7" CornerRadius="4" Background="Transparent" Margin="0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{StaticResource PanelHi}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PresetItem}">
                                        <DockPanel Background="Transparent">
                                            <DockPanel.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            </DockPanel.InputBindings>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="26" MinHeight="22" Height="22"
                                                    Visibility="{Binding IsYours, Converter={StaticResource BoolToVis}}" ToolTip="Delete this preset"
                                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            <TextBlock x:Name="n" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource NameMatches}">
                                                        <Binding Path="Name"/>
                                                        <Binding Path="DataContext.PresetName" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="n" Property="Foreground" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="n" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Equalizer -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Flatten" Command="{Binding FlattenBandsCommand}" Margin="8,0,0,0"
                                        ToolTip="Set every band and boost to 0 dB"/>
                                <Button DockPanel.Dock="Right" Content="Reset to Flat preset" Command="{Binding ResetFlatCommand}" Margin="8,0,0,0"
                                        ToolTip="Sonar's Flat preset: flat EQ and every effect off"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EqEnabled}" HorizontalAlignment="Left" Width="150">
                                    <TextBlock Text="EQUALIZER" Style="{StaticResource Heading}" Margin="0"/>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,8"
                                       Text="Drag a point to move it. Mouse wheel over a point changes how wide it is (Q). Double-click a point to flatten it."/>

                            <!-- Boosts (playback channels) -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="{Binding IsPlayback, Converter={StaticResource BoolToVis}}"
                                  IsEnabled="{Binding EqEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding BassBoost, Converter={StaticResource Num}, ConverterParameter=+0.0 dB;−0.0 dB;0 dB}"/>
                                        <TextBlock Text="BASS" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding BassBoost}" Minimum="-12" Maximum="12" Origin="0" ResetValue="0"
                                                SmallChange="0.5" Fill="{Binding Color}" AutomationProperties.Name="Bass boost"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding VoiceBoost, Converter={StaticResource Num}, ConverterParameter=+0.0 dB;−0.0 dB;0 dB}"/>
                                        <TextBlock Text="VOICE" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding VoiceBoost}" Minimum="-12" Maximum="12" Origin="0" ResetValue="0"
                                                SmallChange="0.5" Fill="{Binding Color}" AutomationProperties.Name="Voice boost"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding TrebleBoost, Converter={StaticResource Num}, ConverterParameter=+0.0 dB;−0.0 dB;0 dB}"/>
                                        <TextBlock Text="TREBLE" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding TrebleBoost}" Minimum="-12" Maximum="12" Origin="0" ResetValue="0"
                                                SmallChange="0.5" Fill="{Binding Color}" AutomationProperties.Name="Treble boost"/>
                                </StackPanel>
                            </Grid>

                            <!-- Selected band -->
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="6" Padding="12" Margin="0,12,0,0" DataContext="{Binding SelectedBand}" IsEnabled="{Binding DataContext.EqEnabled, ElementName=soundPage}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number, StringFormat=BAND {0}}" FontWeight="Bold" FontSize="15"/>
                                        <CheckBox Content="On" IsChecked="{Binding Enabled}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" IsEnabled="{Binding Enabled}">
                                        <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:ChannelSoundViewModel.FilterTypeOptions}" SelectedValue="{Binding Type}"
                                                 AutomationProperties.Name="Filter type"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding FrequencyText}"/>
                                                    <TextBlock Text="FREQUENCY" Style="{StaticResource Label}"/>
                                                </DockPanel>
                                                <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding FrequencyPosition}" Maximum="1000" SmallChange="10"
                                                            AutomationProperties.Name="Band frequency"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" IsEnabled="{Binding HasGain}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding GainText}"/>
                                                    <TextBlock Text="GAIN" Style="{StaticResource Label}"/>
                                                </DockPanel>
                                                <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding Gain}" Minimum="-12" Maximum="12" Origin="0" ResetValue="0"
                                                            SmallChange="0.5" AutomationProperties.Name="Band gain"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding QText}"/>
                                                    <TextBlock Text="WIDTH (Q)" Style="{StaticResource Label}"/>
                                                </DockPanel>
                                                <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding QPosition}" Maximum="1000" SmallChange="20"
                                                            ResetValue="{x:Static vm:EqBandEditViewModel.DefaultQPosition}" AutomationProperties.Name="Band width"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Band buttons -->
                            <ListBox DockPanel.Dock="Bottom" Style="{StaticResource Options}" ItemsSource="{Binding Bands}" SelectedItem="{Binding SelectedBand}"
                                     SelectedValuePath="" DisplayMemberPath="" Margin="0,10,0,0" AutomationProperties.Name="Band">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EqBandEditViewModel}">
                                        <TextBlock x:Name="t" Text="{Binding Number}" MinWidth="18" TextAlignment="Center" FontFamily="{StaticResource MonoFont}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="t" Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" MinHeight="200">
                                <c:EqGraph Bands="{Binding Bands}" SelectedBand="{Binding SelectedBand, Mode=TwoWay}" ExtraFilters="{Binding BoostFilters}"
                                           IsActive="{Binding EqEnabled}" Accent="{Binding Color}" Margin="4"
                                           IsEnabled="{Binding EqEnabled}" AutomationProperties.Name="EQ curve"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Effects -->
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Text="EFFECTS" Style="{StaticResource Heading}"/>

                                <!-- Playback: spatial audio, volume boost, smart volume -->
                                <StackPanel Visibility="{Binding IsPlayback, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource EffectBox}">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" Content="Spatial audio" IsChecked="{Binding SpatialOn}"/>
                                            <TextBlock Style="{StaticResource EffectHint}" Text="Makes sound come from around you instead of inside your head."/>
                                            <StackPanel IsEnabled="{Binding SpatialOn}">
                                                <ListBox Style="{StaticResource Options}" Margin="0,8,0,0" ItemsSource="{x:Static vm:ChannelSoundViewModel.SpatialModeOptions}"
                                                         SelectedValue="{Binding SpatialMode}" AutomationProperties.Name="Spatial audio mode"/>
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="IMMERSION" Style="{StaticResource Label}"/>
                                                    <TextBlock Text="PERFORMANCE" Style="{StaticResource Label}"/>
                                                </DockPanel>
                                                <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding SpatialTuning}" Minimum="-12" Maximum="0" SmallChange="0.5" ResetValue="-6"
                                                            AutomationProperties.Name="Spatial tuning, performance to immersion"/>
                                                <DockPanel Margin="0,10,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding SpatialDistance, StringFormat={}{0:0}%}"/>
                                                    <TextBlock Text="DISTANCE" Style="{StaticResource Label}"/>
                                                </DockPanel>
                                                <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding SpatialDistance}" Maximum="100" SmallChange="5" ResetValue="100"
                                                            AutomationProperties.Name="Speaker distance"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource EffectBox}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                                           Text="{Binding VolumeBoost, Converter={StaticResource Num}, ConverterParameter=+0.0 dB;−0.0 dB;Off}"/>
                                                <TextBlock Text="Volume boost" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource EffectHint}" Text="Raises the level before the other effects, for quiet games."/>
                                            <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding VolumeBoost}" Maximum="12" SmallChange="0.5" ResetValue="0"
                                                        AutomationProperties.Name="Volume boost"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource EffectBox}">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" Content="Smart volume" IsChecked="{Binding SmartVolumeOn}"/>
                                            <TextBlock Style="{StaticResource EffectHint}" Text="Keeps the volume in a range, so it never gets too loud or too quiet."/>
                                            <StackPanel IsEnabled="{Binding SmartVolumeOn}">
                                                <ListBox Style="{StaticResource Options}" Margin="0,8,0,0" ItemsSource="{x:Static vm:ChannelSoundViewModel.LoudnessOptions}"
                                                         SelectedValue="{Binding Loudness}" AutomationProperties.Name="Smart volume loudness"/>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding SmartVolumeLevel, StringFormat={}{0:0}%}"/>
                                                    <TextBlock Text="STRENGTH" Style="{StaticResource Label}"/>
                                                </DockPanel>
                                                <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding SmartVolumeLevel}" Maximum="100" SmallChange="5"
                                                            AutomationProperties.Name="Smart volume strength"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Voice: ClearCast, echo, noise reduction, gate, compressor -->
                                <StackPanel Visibility="{Binding IsVoice, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource EffectBox}">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" Content="ClearCast AI noise cancelling" IsChecked="{Binding NoiseCancelOn}"/>
                                            <TextBlock Style="{StaticResource EffectHint}" Text="Removes everything that isn't a voice, including echo and room sound."/>
                                            <StackPanel IsEnabled="{Binding NoiseCancelOn}">
                                                <DockPanel Margin="0,8,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding NoiseCancelStrength, StringFormat={}{0:0}%}"/>
                                                    <TextBlock Text="STRENGTH" Style="{StaticResource Label}"/>
                                                </DockPanel>
                                                <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding NoiseCancelStrength}" Maximum="100" SmallChange="5" ResetValue="90"
                                                            AutomationProperties.Name="Noise cancelling strength"/>
                                                <CheckBox Style="{StaticResource Switch}" Content="Echo cancelling" IsChecked="{Binding EchoCancelOn}" FontWeight="Normal" Margin="0,10,0,0"
                                                          Visibility="{Binding IsMic, Converter={StaticResource BoolToVis}}"
                                                          ToolTip="Stops what you hear (game, chat) from being picked up by your mic, e.g. when using speakers"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource EffectBox}" IsEnabled="{Binding ClassicNoiseReductionAvailable}">
                                        <StackPanel>
                                            <TextBlock Text="Noise reduction" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource EffectHint}" Text="Background takes out steady noise like fans; impact takes out clicks and keystrokes. Off while ClearCast is on."/>
                                            <CheckBox Style="{StaticResource Switch}" Content="Background" IsChecked="{Binding NoiseReductionOn}" FontWeight="Normal" Margin="0,8,0,0"/>
                                            <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding NoiseReductionLevel}" Maximum="100" SmallChange="5" IsEnabled="{Binding NoiseReductionOn}"
                                                        AutomationProperties.Name="Background noise reduction"/>
                                            <CheckBox Style="{StaticResource Switch}" Content="Impact" IsChecked="{Binding ImpactReductionOn}" FontWeight="Normal" Margin="0,10,0,0"/>
                                            <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding ImpactReductionLevel}" Maximum="100" SmallChange="5" IsEnabled="{Binding ImpactReductionOn}"
                                                        AutomationProperties.Name="Impact noise reduction"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource EffectBox}">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" Content="Noise gate" IsChecked="{Binding NoiseGateOn}"/>
                                            <TextBlock Style="{StaticResource EffectHint}" Text="Cuts the sound completely while it's quieter than the threshold."/>
                                            <StackPanel IsEnabled="{Binding NoiseGateOn}">
                                                <CheckBox Style="{StaticResource Switch}" Content="Set the threshold automatically" IsChecked="{Binding NoiseGateAuto}" FontWeight="Normal" Margin="0,8,0,0"/>
                                                <StackPanel IsEnabled="{Binding NoiseGateManual}">
                                                    <DockPanel Margin="0,6,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding NoiseGateThreshold, StringFormat={}{0:0} dB}"/>
                                                        <TextBlock Text="THRESHOLD" Style="{StaticResource Label}"/>
                                                    </DockPanel>
                                                    <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding NoiseGateThreshold}" Minimum="-60" Maximum="-10" SmallChange="1"
                                                                AutomationProperties.Name="Noise gate threshold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource EffectBox}">
                                        <StackPanel>
                                            <CheckBox Style="{StaticResource Switch}" Content="Compressor" IsChecked="{Binding CompressorOn}"/>
                                            <TextBlock Style="{StaticResource EffectHint}" Text="Evens out loud and quiet speech."/>
                                            <DockPanel Margin="0,8,0,0" IsEnabled="{Binding CompressorOn}">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding CompressorLevel, StringFormat={}{0:0}%}"/>
                                                <TextBlock Text="STRENGTH" Style="{StaticResource Label}"/>
                                            </DockPanel>
                                            <c:LevelBar Style="{StaticResource ValueBar}" Value="{Binding CompressorLevel}" Maximum="100" SmallChange="5" IsEnabled="{Binding CompressorOn}"
                                                        AutomationProperties.Name="Compressor strength"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <TextBlock Grid.RowSpan="3" Text="EQ and effects need the Sonar audio engine, which comes with SteelSeries GG."
                           Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding DataContext.SonarAvailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertVis}}"/>
            </Grid>
        </TabItem>

        <!-- ================= DEVICES ================= -->
        <TabItem Header="DEVICES">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="OUTPUT PRIORITY" Style="{StaticResource Heading}"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Every channel plays on the first ticked device that's available. The headset only counts while it's switched on. Blocked devices are kept disabled so nothing can grab them."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OutputDevices}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="MICROPHONE PRIORITY" Style="{StaticResource Heading}"/>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="The first ticked mic that's available feeds the virtual mic that Discord and games record."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InputDevices}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Column="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MIXER CHANNELS" Style="{StaticResource Heading}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Choose which channel strips the mixer shows."/>
                            <ItemsControl ItemsSource="{Binding ChannelToggles}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChannelToggleViewModel}">
                                        <CheckBox IsChecked="{Binding IsShown}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="WINDOWS DEFAULTS" Style="{StaticResource Heading}"/>
                            <CheckBox Content="Keep them on AudioMixer" IsChecked="{Binding ManageWindowsDefaults}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Playback" Foreground="{StaticResource Subtle}" Margin="0,3"/>
                                <TextBlock Grid.Column="1" Text="Game" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="Communications" Foreground="{StaticResource Subtle}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Chat" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="Recording" Foreground="{StaticResource Subtle}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Virtual mic" Margin="0,3"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="12"
                                       Text="Put back automatically if something, such as a newly plugged-in controller, takes over."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ================= HEADSET ================= -->
        <TabItem Header="HEADSET">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid IsEnabled="{Binding BaseStationConnected}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status + Bluetooth & power -->
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="STATUS" Style="{StaticResource Heading}"/>
                                <ItemsControl ItemsSource="{Binding StatusRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StatusRow}">
                                            <Border BorderBrush="#FF25272C" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <TextBlock x:Name="v" DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Mono}"/>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Subtle}" FontSize="13"/>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Good}" Value="True">
                                                    <Setter TargetName="v" Property="Foreground" Value="{StaticResource Good}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"
                                           Text="Noise mode, mic mute and Bluetooth power are switched with the headset's own buttons; the base station only reports them."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="BLUETOOTH &amp; POWER" Style="{StaticResource Heading}"/>
                                <CheckBox Content="Bluetooth on when the headset powers up" IsChecked="{Binding BluetoothOnAtStartup}"/>
                                <TextBlock Text="During a Bluetooth call" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                                <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.CallModeOptions}" SelectedValue="{Binding CallMode}"/>
                                <TextBlock Text="Headset sleeps after" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                                <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.TimerOptions}" SelectedValue="{Binding SleepAfterMinutes}"/>
                                <TextBlock Text="2.4 GHz link" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                                <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.WirelessOptions}" SelectedValue="{Binding RangeMode}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                    <!-- Base station EQ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Zero bands" Command="{Binding ResetEqCommand}" Margin="8,0,0,4" VerticalAlignment="Top"
                                        ToolTip="Set every band to 0 dB (Custom preset)"/>
                                <ListBox DockPanel.Dock="Right" Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.EqPresetOptions}" SelectedValue="{Binding EqPreset}"/>
                                <StackPanel>
                                    <TextBlock Text="BASE STATION EQ" Style="{StaticResource Heading}" Margin="0"/>
                                    <TextBlock Text="Runs on the base station, so it also applies to Bluetooth. Double-click a band to zero it." Style="{StaticResource Label}"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Height="220" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,22,8,40">
                                    <TextBlock Text="+10" Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Top"/>
                                    <TextBlock Text="0" Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Text="−10" Style="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Faint}" VerticalAlignment="Bottom"/>
                                </Grid>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding EqBands}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EqBandViewModel}">
                                            <DockPanel Margin="3,0">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding GainText}" Style="{StaticResource Mono}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{StaticResource Mono}" Foreground="{StaticResource Subtle}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                <Grid>
                                                    <c:LevelBar Value="{Binding Gain}" Minimum="-10" Maximum="10" Origin="0" Step="0.5" SmallChange="0.5" ResetValue="0"
                                                                MaxWidth="56" AutomationProperties.Name="{Binding Label, StringFormat=EQ band {0} Hz}"/>
                                                    <Border Height="1" Background="{StaticResource LineHi}" MaxWidth="56" IsHitTestVisible="False"/>
                                                </Grid>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Mic & monitoring -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MIC &amp; MONITORING" Style="{StaticResource Heading}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding MicVolume, StringFormat={}{0} / 10}"/>
                                <TextBlock Text="MIC VOLUME" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Height="22" Value="{Binding MicVolume}" Maximum="10" Segments="10" AutomationProperties.Name="Mic volume"/>
                            <CheckBox Content="High mic gain" IsChecked="{Binding HighGain}" Margin="0,12,0,0"/>
                            <TextBlock Text="Sidetone (hear yourself)" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                            <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.SidetoneOptions}" SelectedValue="{Binding Sidetone}"/>
                            <TextBlock Text="Line out on the base station" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                            <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.LineOutOptions}" SelectedValue="{Binding LineOut}"/>
                            <StackPanel Visibility="{Binding IsStreamMix, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="What the line out sends to a stream PC or recorder:"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding StreamMain, StringFormat={}{0}%}"/>
                                    <TextBlock Text="MAIN AUDIO" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <c:LevelBar Style="{StaticResource StepBar}" Value="{Binding StreamMain}" Maximum="100" Step="5" SmallChange="5" Segments="20" AutomationProperties.Name="Stream mix main"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding StreamAux, StringFormat={}{0}%}"/>
                                    <TextBlock Text="AUX" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <c:LevelBar Style="{StaticResource StepBar}" Value="{Binding StreamAux}" Maximum="100" Step="5" SmallChange="5" Segments="20" AutomationProperties.Name="Stream mix aux"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding StreamMic, StringFormat={}{0}%}"/>
                                    <TextBlock Text="MIC" Style="{StaticResource Label}"/>
                                </DockPanel>
                                <c:LevelBar Style="{StaticResource StepBar}" Value="{Binding StreamMic}" Maximum="100" Step="5" SmallChange="5" Segments="20" AutomationProperties.Name="Stream mix mic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Screen & lights -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SCREEN &amp; LIGHTS" Style="{StaticResource Heading}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding Brightness, StringFormat={}{0} / 10}"/>
                                <TextBlock Text="SCREEN BRIGHTNESS" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Height="22" Value="{Binding Brightness}" Maximum="10" Segments="10" AutomationProperties.Name="Screen brightness"/>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding MutedMicBrightness, StringFormat={}{0} / 10}"/>
                                <TextBlock Text="MIC-MUTED LIGHT" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Height="22" Value="{Binding MutedMicBrightness}" Maximum="10" Segments="10" AutomationProperties.Name="Mic muted light brightness"/>
                            <TextBlock Text="Dim the screen after" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                            <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.TimerOptions}" SelectedValue="{Binding DimAfterMinutes}"/>
                            <TextBlock Text="Home screen" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                            <ListBox Style="{StaticResource Options}" ItemsSource="{x:Static vm:MainViewModel.HomeScreenOptions}" SelectedValue="{Binding SimpleHomeScreen}"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- ================= SETTINGS ================= -->
        <TabItem Header="SETTINGS">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GENERAL" Style="{StaticResource Heading}"/>
                            <CheckBox Content="Start with Windows (in the tray)" IsChecked="{Binding StartWithWindows}"/>
                            <DockPanel Margin="0,14,0,0">
                                <TextBlock DockPanel.Dock="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                            <Setter Property="Text" Value="{Binding LowBatteryWarning, StringFormat={}{0}%}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LowBatteryWarning}" Value="0">
                                                    <Setter Property="Text" Value="OFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="WARN WHEN THE HEADSET BATTERY DROPS TO" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <c:LevelBar Style="{StaticResource StepBar}" Height="22" Value="{Binding LowBatteryWarning}" Maximum="50" Step="5" SmallChange="5" Segments="10"
                                        AutomationProperties.Name="Low battery warning"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="STEELSERIES GG" Style="{StaticResource Heading}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="AudioMixer uses the Sonar audio driver and engine that GG installed, and replaces the GG and Sonar apps. Keep GG installed so the driver stays; it just doesn't need to run. Use GG for firmware updates."/>
                            <Button Content="Let GG start with Windows again" Command="{Binding RestoreGGCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ABOUT" Style="{StaticResource Heading}"/>
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="AudioMixer is open source and not affiliated with SteelSeries."/>
                                <LineBreak/>
                                <Hyperlink NavigateUri="https://github.com/Marleybop/AudioMixer" RequestNavigate="OnLink" Foreground="{StaticResource Accent}">github.com/Marleybop/AudioMixer</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
